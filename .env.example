APP_NAME=PadayON
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

# Central Domain Configuration
CENTRAL_DOMAIN=padayon.ph

# Multi-tenancy
TENANCY_DEFAULT_TENANT=

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=padayon
DB_USERNAME=root
DB_PASSWORD=

# Redis (for queues, cache, sessions)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Session & Cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Broadcasting (Pusher for real-time updates)
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

# PayMongo Configuration
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVEMODE=false

# GCash Direct (if applicable)
GCASH_MERCHANT_ID=
GCASH_API_KEY=

# Maya/PayMaya (if applicable)
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=

# DragonPay (for OTC payments)
DRAGONPAY_MERCHANT_ID=
DRAGONPAY_PASSWORD=
DRAGONPAY_API_URL=https://test.dragonpay.ph/api/collect/v1

# SMS Provider - Semaphore
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=PadayON

# Alternative SMS - Infobip
INFOBIP_API_KEY=
INFOBIP_BASE_URL=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@padayon.ph"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=padayon-assets
AWS_USE_PATH_STYLE_ENDPOINT=false

# Filesystem
FILESYSTEM_DISK=local

# Cloudflare (for SSL/DNS)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# LBC Express API (for COD/Delivery)
LBC_API_KEY=
LBC_API_SECRET=
LBC_ACCOUNT_ID=

# J&T Express API
JT_API_KEY=
JT_CUSTOMER_ID=

# Google Maps API (for delivery routing)
GOOGLE_MAPS_API_KEY=

# BIR Integration (for e-invoicing)
BIR_TIN=
BIR_BRANCH_CODE=
BIR_EIS_ENDPOINT=

# E-Loading Provider (for sari-sari)
ELOAD_PROVIDER_API_KEY=
ELOAD_PROVIDER_ENDPOINT=

# Backup
BACKUP_DISK=s3
BACKUP_NOTIFICATION_EMAIL=admin@padayon.ph

# Horizon
HORIZON_DARK_MODE=false

# Feature Flags
FEATURE_LAUNDRY_MODULE=true
FEATURE_CATERING_MODULE=true
FEATURE_SARI_MODULE=true
FEATURE_WEBSITE_BUILDER=true
FEATURE_ELOADING=true
FEATURE_BILLS_PAYMENT=true

# Rate Limiting
API_RATE_LIMIT=60
SMS_DAILY_LIMIT_FREE=50
SMS_DAILY_LIMIT_STARTER=500
SMS_DAILY_LIMIT_PRO=2000
